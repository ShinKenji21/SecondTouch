# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# Leave the key blank to run with the local template engine only.

# Azure portal -> your Azure OpenAI resource -> Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/

# The name you gave the model deployment (not the model name, unless they match)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# Optional
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TIMEOUT_S=6
EVENT_INTERVAL_S=1.5
# AI commentary for the first N matches of each visit (then the local engine); Talk to AI always uses the model
AI_MATCHES_PER_VIEWER=2

# Optional: trace every agent run to Azure Application Insights (Azure portal -> Application Insights ->
# Overview -> Connection String). Connect the same resource to your Foundry project to see the runs there.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# 1 = also record prompts and replies in the traces (off by default)
TRACE_CONTENT=
